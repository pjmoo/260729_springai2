<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springai2.mapper.ChatMessageMapper">
    <!--  List<String> findConversationIds();  -->
    <select id="findConversationIds" resultType="string">
        SELECT DISTINCT conversation_id
        FROM chat_message
    </select>
    <!--  List<ChatMessageMyBatis> findByConversationId(String conversationId);  -->
    <!--  mybatis.type-aliases-package=org.example.mybatis.entity  -->
    <select id="findByConversationId" resultType="ChatMessageMyBatis">
        SELECT
        conversation_id,
        message_type,
        content,
        seq
        FROM chat_message
        WHERE conversation_id = #{conversationId}
        ORDER BY seq DESC
    </select>
    <!--  void insertAll(List<ChatMessageMyBatis> messages);  -->
    <insert id="insertAll">
        INSERT INTO chat_message (conversation_id, message_type, content, seq)
        VALUES
        <foreach collection="messages" item="message" separator=",">
            (#{message.conversationId}, #{message.messageType}, #{message.content}, #{message.seq})
        </foreach>
    </insert>
    <!--  void deleteByConversationId(String conversationId);  -->
    <delete id="deleteByConversationId">
        DELETE FROM chat_message
        WHERE conversation_id = #{conversationId}
    </delete>
</mapper>